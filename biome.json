{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "files": {
    "includes": ["src/**/*.ts", "test/**/*.ts"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    },
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSpacing": true
    }
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "off",
        "noUnusedVariables": "off",
        "noUnreachable": "error",
        "noUnusedFunctionParameters": "off"
      },
      "complexity": {
        "noUselessContinue": "off",
        "noStaticOnlyClass": "off",
        "noThisInStatic": "off",
        "useOptionalChain": "off",
        "useLiteralKeys": "off"
      },
      "suspicious": {
        "noAsyncPromiseExecutor": "error",
        "noDebugger": "error",
        "noDuplicateClassMembers": "error",
        "noExplicitAny": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useConst": "error",
        "useImportType": "off",
        "useTemplate": "off"
      }
    }
  }
}
